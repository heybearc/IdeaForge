*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
*.egg-info/
dist/
build/

# ML Models (keep training data, ignore large model files)
ml-engine/models/*.pkl
ml-engine/models/*.h5
ml-engine/models/*.joblib

# Environment variables
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Cursor — machine-local (MCP config uses absolute paths; regenerate via
# `.cloudy-work/scripts/sync-cursor-mcp.sh` or MC portable setup).
.cursor/

# Windsurf: use one symlink — `.windsurf` → `.cloudy-work/.windsurf` (committed).
# Do not replace it with a copied directory or git will show lots of untracked noise.

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.bak

# Keep these
!ml-engine/models/training_data.json
!ml-engine/models/.gitkeep
